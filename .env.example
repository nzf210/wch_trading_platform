APP_NAME=WCH Trading Platform
APP_ENV=production
APP_URL=https://bot-trading.wancash.org

WEB_PORT=3000
API_PORT=8080

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wch_trading
POSTGRES_USER=wch_user
POSTGRES_PASSWORD=wch_password
DATABASE_URL=postgres://{{POSTGRES_USER}}:{{POSTGRES_PASSWORD}}@{{POSTGRES_HOST}}:{{POSTGRES_PORT}}/{{POSTGRES_DB}}?sslmode=disable

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

JWT_SECRET=change_this_jwt_secret
ENCRYPTION_KEY=change_this_32_character_key

WCH_CHAIN=bsc
WCH_TOKEN_ADDRESS=0xYourWchTokenAddress
WCH_DECIMALS=18

DEFAULT_TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

BINANCE_BASE_URL=https://api.binance.com
BYBIT_BASE_URL=https://api.bybit.com
OKX_BASE_URL=https://www.okx.com

SCANNER_INTERVAL_SECONDS=10
MAX_ACTIVE_BOTS_PER_USER=3
MAX_DAILY_LOSS_PERCENT=5
MAX_POSITION_SIZE_PERCENT=20

AI_AGENT_ENABLED=true
OPENAI_API_KEY=your_openai_api_key

# OpenClaw & Telegram
OPENCLAW_BASE_URL=http://127.0.0.1:18789/v1
OPENCLAW_API_KEY=sk-openclaw-dummy-key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
